	section	.text,"ax",@progbits
	public	_ui_manager_on_cp_select
_ui_manager_on_cp_select:
	ld	hl, -6
	call	__frameset
	ld	iy, (ix + 6)
	xor	a, a
	ld	de, 0
	bit	0, (iy + 3)
	jp	z, BB84_13
	ld	hl, (iy + 4)
	add	hl, bc
	or	a, a
	sbc	hl, bc
	jr	nz, BB84_3
	ld	hl, (iy)
	push	hl
	call	_game_on_toggle_vents
	pop	hl
	jp	BB84_13
BB84_3:
	ld	bc, 1
	or	a, a
	sbc	hl, bc
	jp	nz, BB84_13
	ld	iy, (iy)
	bit	0, (iy + 10)
	jp	nz, BB84_13
	bit	0, (iy + 11)
	jp	nz, BB84_13
	ld	bc, 150
	ld	(ix - 3), iy
	add	iy, bc
	ld	iy, (iy)
	bit	0, (iy + 11)
	jr	nz, BB84_9
	ld	bc, 164
	ld	hl, (ix - 3)
	add	hl, bc
	ld	(ix - 6), hl
	ld	hl, (hl)
	add	hl, bc
	or	a, a
	sbc	hl, bc
	jr	nz, BB84_9
	ld	(iy + 10), 1
	ld	(iy + 11), 1
	ld	hl, (ix - 6)
	ld	bc, 1
	ld	(hl), bc
	ld	bc, (ix - 3)
	push	bc
	pop	hl
	push	de
	pop	iy
	ld	de, 167
	add	hl, de
	lea	de, iy
	ld	(hl), de
	push	hl
	pop	iy
	lea	hl, iy + 3
	ld	(hl), 0
	push	bc
	pop	iy
	ld	a, (iy + 10)
BB84_9:
	ld	iy, (ix - 3)
	ld	l, (iy + 8)
	ld	iy, (ix + 6)
	ld	(iy + 12), l
	ld	(iy + 18), a
	bit	0, l
	jr	nz, BB84_11
	ld	(iy + 7), 0
	ld	(iy + 8), de
	ld	(iy + 11), 0
BB84_11:
	bit	0, a
	jr	nz, BB84_13
	ld	(iy + 13), 0
	ld	(iy + 14), de
	ld	(iy + 17), 0
BB84_13:
	ld	sp, ix
	pop	ix
	ret
