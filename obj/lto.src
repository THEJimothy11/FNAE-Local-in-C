	call	_zx0_Decompress
	pop	hl
	pop	hl
	ld	iy, (ix + 18)
	ld	de, (ix + 21)
	ld	bc, 1
	ld	hl, (ix + 9)
	or	a, a
	sbc	hl, bc
	jr	z, BB80_6
	ld	c, 0
	jr	BB80_7
BB80_6:
	ld	c, 1
BB80_7:
	ld	l, e
	ld	h, d
	call	__sshl
	ld	e, l
	ld	d, h
	ex	de, hl
	ld	e, iyl
	ld	d, iyh
	ex	de, hl
	call	__sshl
	ld	b, 0
	ld	iy, (ix - 3)
	ld	c, (iy)
	call	__sdivu
	inc	l
	ld	(ix - 6), hl
	ld	iy, (ix - 3)
	ld	c, (iy + 1)
	ld	l, e
	ld	h, d
	call	__sdivu
	inc	l
	ld	(ix - 9), hl
	ld	hl, 240
	push	hl
	push	hl
	or	a, a
	sbc	hl, hl
	push	hl
	push	hl
	call	_gfx_SetClipRegion
	pop	hl
	pop	hl
	pop	hl
	pop	hl
	or	a, a
	sbc	hl, hl
	ld	de, (ix + 12)
	ld	l, e
	ld	h, d
	ld	de, (ix - 9)
	push	de
	ld	de, (ix - 6)
	push	de
	ld	a, (ix + 15)
	ld	e, a
	push	de
	push	hl
	ld	hl, (ix - 3)
	push	hl
	call	_gfx_ScaledTransparentSprite_NoClip
	pop	hl
	pop	hl
	pop	hl
	pop	hl
	pop	hl
BB80_8:
	ld	sp, ix
	pop	ix
	ret
