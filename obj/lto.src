	section	.text,"ax",@progbits
	public	_ui_manager_on_control_panel_toggle
_ui_manager_on_control_panel_toggle:
	call	__frameset0
	ld	iy, (ix + 6)
	bit	0, (iy + 3)
	jr	nz, BB82_2
	ld	(iy + 3), 1
	ld	iy, (iy)
	ld	(iy + 12), 1
	lea	hl, iy
	ld	de, 247
	add	iy, de
	ld	(iy), d
	inc	de
	add	hl, de
	jr	BB82_4
BB82_2:
	lea	de, iy
	ld	iy, (iy)
	lea	hl, iy
	bit	0, (iy + 11)
	jr	nz, BB82_5
	push	de
	pop	iy
	ld	(iy + 3), 0
	push	hl
	pop	iy
	lea	hl, iy + 12
BB82_4:
	ld	(hl), 0
BB82_5:
	pop	ix
	ret
	section	.text,"ax",@progbits

	section	.text,"ax",@progbits
	public	_ui_manager_on_cp_move_cursor
_ui_manager_on_cp_move_cursor:
	call	__frameset0
	ld	iy, (ix + 6)
	ld	de, 0
	bit	0, (iy + 3)
	jr	z, BB83_6
	ld	bc, (ix + 9)
	ld	iy, (iy + 4)
	add	iy, bc
	ld	bc, 0
	lea	hl, iy
	or	a, a
	sbc	hl, bc
	call	pe, __setflag
	jp	p, BB83_3
	ld	iy, 1
BB83_3:
	ld	bc, 2
	lea	hl, iy
	or	a, a
	sbc	hl, bc
	jr	nc, BB83_5
	lea	de, iy
BB83_5:
	ld	iy, (ix + 6)
	ld	(iy + 4), de
BB83_6:
	pop	ix
	ret
