	section	.text,"ax",@progbits
	public	_ui_manager_draw_explosion_frame
_ui_manager_draw_explosion_frame:
	ld	hl, -15
	call	__frameset
	ld	de, _decomp_buf_b
	ld	hl, _exp2_compressed
	push	hl
	push	de
	call	_zx0_Decompress
	pop	hl
	pop	hl
	ld	a, (_decomp_buf_b)
	ld	b, 2
	call	__bshru
	ld	h, a
	ld	a, (_decomp_buf_b+1)
	ld	e, a
	ld	a, (ix + 9)
	and	a, 3
	ld	l, a
	ld	bc, 0
	ld	c, h
	ld	(ix - 9), bc
	mlt	hl
	ld	(ix - 6), hl
	ld	hl, 240
	or	a, a
	sbc	hl, bc
	ld	c, 1
	call	__ishru
	ld	(ix - 3), hl
	or	a, a
	sbc	hl, hl
	ld	l, e
	ld	(ix - 12), hl
	ld	d, b
	ld.sis	hl, 240
	sbc.sis	hl, de
	ld.sis	bc, 2
	call	__sdivs
	ld	de, 0
	ld	e, l
	ld	d, h
	ex	de, hl
	ld	iy, (ix - 3)
	ld	de, (ix - 9)
	add	iy, de
	push	hl
	pop	de
	ld	(ix - 15), de
	ld	bc, (ix - 12)
	add	hl, bc
	push	hl
	push	iy
	push	de
	ld	hl, (ix - 3)
	push	hl
	call	_gfx_SetClipRegion
	pop	hl
	pop	hl
	pop	hl
	pop	hl
	ld	de, 0
	ld	hl, (ix - 6)
	ld	e, l
	ld	hl, (ix - 3)
	or	a, a
	sbc	hl, de
	ld	de, (ix - 15)
	push	de
	push	hl
	ld	hl, _decomp_buf_b
	push	hl
	call	_gfx_Sprite
	pop	hl
	pop	hl
	pop	hl
	ld	hl, 240
	push	hl
	push	hl
	or	a, a
	sbc	hl, hl
	push	hl
	push	hl
	call	_gfx_SetClipRegion
	ld	sp, ix
	pop	ix
	ret
